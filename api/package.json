{
  "name": "conecta-api",
  "version": "0.1.0",
  "description": "API de Conecta: acopio, calidad, liquidación al productor y trazabilidad de la leche",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
